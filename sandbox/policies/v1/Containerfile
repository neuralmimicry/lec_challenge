# Build only through the explicit online bootstrap command. Candidate runs never
# pull images or download crates. The resulting immutable image ID is frozen.
FROM docker.io/library/rust@sha256:b36c246742b4d323472588f789601be34eb4af053255e2af53969078ee8dcec7
WORKDIR /build
COPY sandbox/deps/ /build/deps/
RUN cargo build --locked --release --manifest-path /build/deps/Cargo.toml && mkdir -p /opt/deps && cp /build/deps/target/release/deps/*.rlib /opt/deps/ && find /opt/deps -name 'libserde_json-*.rlib' > /opt/deps/serde_json.path
COPY sandbox/audit.rs /build/audit.rs
COPY sandbox/probe.rs /build/probe.rs
RUN rustc --edition=2024 -O -L dependency=/opt/deps --extern serde_json=$(cat /opt/deps/serde_json.path) /build/audit.rs -o /usr/local/bin/lec-audit && rustc --edition=2024 -O -L dependency=/opt/deps --extern serde_json=$(cat /opt/deps/serde_json.path) /build/probe.rs -o /usr/local/bin/lec-probe && touch /opt/rootfs-probe && chmod 666 /opt/rootfs-probe && rm -rf /build
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/lec-audit"]
