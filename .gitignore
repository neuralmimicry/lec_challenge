# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Immutable large assets belong in a separately checksummed delivery bundle.
offline_bundle/base/*.safetensors
offline_bundle/comparative/**/*.safetensors
offline_bundle/comparative/**/*.gguf
offline_bundle/students/**/*.safetensors
offline_bundle/students/**/*.gguf
offline_bundle/students/**/.*.partial
offline_bundle/students/**/.*.partial.json
offline_bundle/students/**/.*.part-*
offline_bundle/students/**/.hub-download.lock
offline_bundle/students/**/.*.rejected-*
offline_bundle/distillation-traces/
offline_bundle/comparative/**/.*.partial
offline_bundle/comparative/**/.*.partial.json
offline_bundle/comparative/**/.*.part-*
offline_bundle/comparative/**/.hub-download.lock
offline_bundle/comparative/**/.*.rejected-*
reports/comparative/**/.process.lock
reports/**/.explore.lock
reports/**/.study-evaluation.lock
reports/**/.study-evaluation-preparation.lock
reports/**/.scheduler.lock
reports/**/.worker.lock
reports/**/.evaluation.lock
reports/**/.content-collection.lock
reports/**/.rollout-collection.lock
reports/**/.search.lock
reports/**/.helper-launch.lock
reports/**/.build.lock
reports/**/*.export.lock
reports/**/*.gguf
reports/**/*.gguf.parts/
reports/comparative/bitnet/**/*.safetensors
reports/comparative/bitnet/**/*.trits
reports/local-study/**/*.safetensors
offline_bundle/comparative/.teacher-search-pool.lock
offline_bundle/images/
offline_bundle/bin/
offline_bundle/vendor/
state/
data/
deliverables/
reports/drill-work/
checkpoints/**/*.safetensors
*.tar.gz
.env

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Generated model tensor parts
/offline_bundle/**/*.gguf.parts/
