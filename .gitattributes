# Keep Rust sources and prose consistent across developer checkouts.
* text=auto eol=lf

# Provenance and checksum-bound evidence must retain the original bytes.
docs/rights/snapshots/** -text
docs/comparative-models/provenance/** -text
offline_bundle/** -text
recordings/** -text
reports/** -text
tasks/** -text
grader_private/** -text
*.pdf -text
*.mp4 -text

# Publisher evidence and reviewed diffs retain their exact original bytes.
docs/comparative-models/replacements/** -text -whitespace
docs/bitnet/*.patch -text -whitespace
docs/bitnet/provenance/upstream-notices/** -text -whitespace
